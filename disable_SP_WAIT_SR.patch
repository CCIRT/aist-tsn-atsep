# This patch is derived from the Linux kernel (drivers/net/ethernet/intel/igb/igb_main.c).
# SPDX-License-Identifier: GPL-2.0-only
diff --git a/drivers/net/ethernet/intel/igb/igb_main.c b/drivers/net/ethernet/intel/igb/igb_main.c
index f3a433b4c7cd..28a4984a7464 100644
--- a/drivers/net/ethernet/intel/igb/igb_main.c
+++ b/drivers/net/ethernet/intel/igb/igb_main.c
@@ -1925,7 +1925,10 @@ static void igb_setup_tx_mode(struct igb_adapter *adapter)
 		 * so SP queues wait for SR ones.
 		 */
 		val = rd32(E1000_I210_TQAVCTRL);
-		val |= E1000_TQAVCTRL_XMIT_MODE | E1000_TQAVCTRL_SP_WAIT_SR;
+		val |= E1000_TQAVCTRL_XMIT_MODE;
+		/* Note: Original code set SP_WAIT_SR here.
+		 * val |= E1000_TQAVCTRL_XMIT_MODE | E1000_TQAVCTRL_SP_WAIT_SR;
+		 */
 		val &= ~E1000_TQAVCTRL_DATAFETCHARB;
 		wr32(E1000_I210_TQAVCTRL, val);
 
